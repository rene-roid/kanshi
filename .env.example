# Copy to .env (Docker Compose) or kanshi.env (the standalone binary) to
# override. Every value here is the built-in default.

# Who can open the dashboard. This computer (localhost) always can. Add any of:
#   lan        other devices on your local network, wired or Wi-Fi
#   tailscale  your devices on your tailnet
#   all        every interface — kanshi has no login, so only behind a firewall
# Combine with commas, e.g. KANSHI_ACCESS=lan,tailscale
KANSHI_ACCESS=local
KANSHI_PORT=8100

# Live metrics
KANSHI_POLL_INTERVAL=5
KANSHI_DOCKER_CONCURRENCY=8
KANSHI_IDLE_TIMEOUT=30

# Storage map. "auto" is / plus every drive under /mnt on Linux, or C:\, your
# user folder and every other fixed drive on Windows. List paths to replace
# that, or mix: auto,/srv
KANSHI_STORAGE_ROOTS=auto
KANSHI_STORAGE_INTERVAL=1800
# Paths to skip entirely, comma separated. The biggest win on a Docker host is
# /var/lib/docker — ~100k overlay2 files.
KANSHI_STORAGE_EXCLUDE=
# Share of one core, in percent, the walk may average. 100 = unthrottled.
KANSHI_STORAGE_CPU=25
KANSHI_TREE_DEPTH=4
